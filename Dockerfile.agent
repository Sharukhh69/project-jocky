# Dockerfile.agent — JOCKY Target Machine Agent
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    procps \
    net-tools \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir flask flask-cors psutil requests

COPY agent/agent.py .

EXPOSE 5000

ENV PYTHONUNBUFFERED=1
ENV JOCKY_SERVER_URL=http://jocky-server:8000

CMD ["python", "agent.py"]
